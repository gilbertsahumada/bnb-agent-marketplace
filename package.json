{
  "name": "bnb-agent-marketplace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "start": "next start",
    "build": "npm run build:cli && npm run build:web",
    "build:cli": "tsc -p tsconfig.build.json",
    "build:web": "next build --webpack",
    "check": "npm run typecheck && npm test && npm run build",
    "gate1": "tsx src/cli.ts",
    "gate1:seller": "tsx src/seller.ts",
    "hosted-seller:register": "node --env-file=.env.local --import tsx src/hosted-seller-cli.ts register",
    "inventory:bsc": "tsx src/trust8004/inventory-cli.ts",
    "verify:bsc": "tsx src/verification/cli.ts",
    "readiness:bsc": "tsx src/readiness/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bnbagent/sdk": "0.5.0",
    "@modelcontextprotocol/client": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "6.28.0",
    "viem": "2.55.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.17.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.11.0",
    "happy-dom": "^20.11.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
